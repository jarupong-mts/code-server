# Use the latest upstream code-server image on each rebuild.
CODE_SERVER_VERSION=latest

# Toolchain versions. Keep latest while evaluating; pin tested versions for CI.
UV_VERSION=latest
CLAUDE_CODE_VERSION=latest
CODEX_CLI_VERSION=latest
PI_CODING_AGENT_VERSION=latest

# Required. Use a long, unique password. Keep the real .env out of git.
# `make up` prompts for this when it is unset or still the placeholder.
CODE_SERVER_PASSWORD=replace-with-a-long-random-password

# Use UTC or an IANA timezone such as Asia/Bangkok.
TZ=UTC

# Host-specific values. Leave the empty ones blank: `make up` fills them in on
# this host (see scripts/setup-env.sh). Set a value by hand to override it.
#
# Compose files, asked by `make up`. "compose.yaml" routes code-server through
# Traefik. "compose.yaml:compose.direct.yaml" publishes it on the bind IP and port
# below.
COMPOSE_FILE=
CODE_SERVER_BIND_IP=
CODE_SERVER_PORT=

# Host path for persistent data.
CODE_SERVER_HOME_PATH=./data/home

# Host path mounted at /home/coder/project. Empty means the parent of this
# checkout, so the browser opens the directory that holds this project.
CODE_SERVER_WORKSPACE_PATH=

# Uid and gid code-server runs as. The uid is this user's id; the gid is the
# group that owns the Docker socket as seen from a container, which differs
# from the host's group id under rootless Docker.
CODE_SERVER_UID=
CODE_SERVER_GID=

# Optional username shown inside the container.
DOCKER_USER=coder

# Docker socket bind-mounted for controlling the host daemon from inside
# code-server. Detected as /var/run/docker.sock, or the user's runtime socket
# under rootless Docker.
DOCKER_SOCKET_PATH=

# T3 Code on port 3773 is protected by basic auth in front of it. Generate the
# hash with `htpasswd -nbB <user> <password>` (or `caddy hash-password`), and
# keep the value in single quotes so `$` is not interpolated.
T3_USER=admin
T3_PASSWORD_HASH='$2y$05$replace-with-bcrypt-hash'

# Interface to publish port 3773 on. 0.0.0.0 means all interfaces; set a LAN or
# Tailscale IP to limit who can reach it.
T3_BIND_IP=0.0.0.0

# Applied only when no user settings exist. Existing settings are preserved.
CODE_SERVER_THEME=Default Dark Modern

# Comma-separated Open VSX extension IDs. Missing extensions are installed at startup.
VSCODE_EXTENSIONS=ms-python.python,charliermarsh.ruff,esbenp.prettier-vscode,dbaeumer.vscode-eslint,redhat.vscode-yaml,yzhang.markdown-all-in-one
