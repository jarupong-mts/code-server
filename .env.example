# Use the latest upstream code-server image on each rebuild.
CODE_SERVER_VERSION=latest

# Toolchain versions. Keep latest while evaluating; pin tested versions for CI.
UV_VERSION=latest
CLAUDE_CODE_VERSION=latest
CODEX_CLI_VERSION=latest
OPENCODE_CLI_VERSION=latest

# Required. Use a long, unique password. Keep the real .env out of git.
CODE_SERVER_PASSWORD=replace-with-a-long-random-password

# Use UTC or an IANA timezone such as Asia/Bangkok.
TZ=UTC

# Host paths for persistent data. Use directories owned by the deploying user.
# Absolute paths are recommended when deploying from a server.
CODE_SERVER_HOME_PATH=./data/home
CODE_SERVER_WORKSPACE_PATH=./workspace

# Uid the code-server process runs as. Matters for ownership of the
# persisted home/workspace volumes above.
# CODE_SERVER_UID=1000
# CODE_SERVER_GID=1000

# Optional username shown inside the container.
DOCKER_USER=coder

# Docker socket to bind-mount for controlling the host daemon from inside
# code-server (e.g. `docker compose up -d --build` for other projects under
# projects/). Defaults to the standard rootful socket, owned root:docker —
# set CODE_SERVER_GID to that group's id (`stat -c '%g' /var/run/docker.sock`
# on the host).
#
# If this host runs rootless Docker instead (check with `docker context ls`
# on the host — a context pointing at /run/user/<uid>/docker.sock means
# rootless), point this at that socket instead. If the container that
# mounts it is *also* created by that same rootless engine (the common case
# when code-server deploys itself from a rootless Docker host), don't trust
# `id <uid>` on the host for the gid — rootlesskit remaps uids/gids for
# every container on that engine, so the numbers differ from the host's.
# Instead, get *any* container on that engine running (even with the wrong
# permission for now) and read the gid directly off `ls -la
# /var/run/docker.sock` from inside it — that's the number that actually
# matters, and it can look nothing like the host user's real gid.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Applied only when no user settings exist. Existing settings are preserved.
CODE_SERVER_THEME=Default Dark Modern

# Comma-separated Open VSX extension IDs. Missing extensions are installed at startup.
VSCODE_EXTENSIONS=ms-python.python,ms-python.vscode-pylance,charliermarsh.ruff,esbenp.prettier-vscode,dbaeumer.vscode-eslint,redhat.vscode-yaml,yzhang.markdown-all-in-one
